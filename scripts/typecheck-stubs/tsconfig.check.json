{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [],
    "paths": { "@/*": ["../../*"] }
  },
  "include": [
    "stubs.d.ts",
    "../../app/**/*.ts",
    "../../app/**/*.tsx",
    "../../components/**/*.tsx",
    "../../lib/**/*.ts",
    "../../lib/**/*.tsx"
  ]
}
